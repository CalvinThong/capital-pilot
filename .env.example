RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=xxx
AGENT_PRIVATE_KEY=xx

POLL_INTERVAL_MS=300000
EXECUTION_ENABLED=true

# DeploySepolia initial mock supply in smallest units (mUSDC 6 decimals, mBTC 8 decimals)
MOCK_USDC_MINT=1000000000000   # 1,000,000 mUSDC
MOCK_BTC_MINT=10000000000      # 100 mBTC


# Deploy Factory and Aqua Swap Adapter
ASSET_A=0x6eccFDfDCeC489a927aDC58b31a8a21A86Ea0482
ASSET_B=0x25e78e575Ade6FBa7bfa1a5aDe14fd2D6f5f43f3
AQUA=0x1111113ccf1426a8e30e2bff5e005d929bf6a90a
AUTHORIZED_AGENT=0x0000000000000000000000000000000000000000

# Deploy Vault
ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
REGIME_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# STRATEGY=0
# MIN_TRADE=1e18
# MAX_TRADE=1e21

# LLM TO USE
OPENAI_ENABLED=true
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Vault address for SwapVM
MARKET_MAKER_ONLY_VAULTS=0x0000000000000000000000000000000000000000
MARKET_MAKER_AMOUNT_A=10000
MARKET_MAKER_AMOUNT_B=1
MARKET_MAKER_MIN_TRADE=10000000      # 10 mUSDC
MARKET_MAKER_MAX_TRADE=10000000000    # 1,000 mUSDC

FORCE_GLOBAL_MODE=TRADING 


REGIME_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
FORCE_STRATEGIES=

MARKET_SYMBOL=BTCUSDT
MARKET_INTERVAL=1h
MARKET_REFRESH_MS=300000
MARKET_CANDLE_LIMIT=200
MARKET_SYNC_ON_START=true
CANDLE_CSV_PATH=

# Close every open position
FORCE_CLOSE_VAULTS=ALL
# Or only specific vaults (comma-separated)
# FORCE_CLOSE_VAULTS=0xVault1,0xVault2